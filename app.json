{
  "expo": {
    "name": "SOL·Pay",
    "slug": "solpay-agent-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gollacard.solpay.dev",
      "supportsTablet": true
    },
    "android": {
      "package": "com.gollacard.solpay.dev",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "d42d9086-7b1d-40cc-bcd8-0636b42c5bb8"
      }
    },
    "owner": "ssbeom-2"
  }
}
