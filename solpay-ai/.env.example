# solpay-ai/.env 로 복사해서 값을 채운다 (.env 는 깃에 올리지 않는다). 운영에서는 SSM 에 둔다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHAT_TIMEOUT_SEC=15
CHAT_MAX_TOOL_CALLS=3
CHAT_HISTORY_TURNS=10

# 데이터: 팀 DB 형식 CSV 폴더 (기본 ../카드서비스_DB_1년). DB 로 바꿀 때는 SOLPAY_TEAM_DB_SOURCE=postgres
# SOLPAY_TEAM_DB_DIR=../카드서비스_DB_1년
# SOLPAY_TEAM_DB_SOURCE=postgres
# SOLPAY_DATABASE_URL=postgresql://solpay_app:비밀번호@localhost:5432/solpay
# SOLPAY_TEAM_DB_SCHEMA=public
# DB 연결 풀: 최대 연결 수, 연결을 기다리는 시간(초)
# SOLPAY_DB_POOL_MAX=10
# SOLPAY_DB_POOL_TIMEOUT=5
