# backend/.env 로 복사해서 값을 채운다 (.env 는 깃에 올리지 않는다). 서버가 뜰 때 자동으로 읽는다.
DB_URL=jdbc:postgresql://localhost:5432/solpay
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=

# AI 엔진 (solpay-ai). 토큰은 AI 엔진의 SOLPAY_INTERNAL_TOKEN 과 같은 값, 비우면 검사하지 않는다
AI_BASE_URL=http://localhost:8001
AI_INTERNAL_TOKEN=
# 시연용 기준 시각. 비우면 현재 시각 (예: 2026-11-05T09:30:00)
AI_FIXED_AT=

# 웹에서 부를 수 있게 허용할 주소 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# 시연용 가상 POS 만능 키 (16자 이상, 예: openssl rand -hex 16). 있으면 백엔드 /pos 화면과 시연 API 가 켜지고,
# demo/ 파이썬 POS 도 같은 값으로 아무 가맹점에서 결제한다. 비우면 꺼진다. 실제 값은 깃에 올리지 않는다
POS_DEMO_TERMINAL_KEY=
